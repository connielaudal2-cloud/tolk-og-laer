{
  "name": "tolk-og-laer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run typecheck lint",
    "test": "turbo run test",
    "test:rls:remote": "pnpm --filter @tolk-og-laer/api-client build && pnpm --filter @tolk-og-laer/rls-tests test:remote",
    "format:check": "prettier --check .",
    "mobile": "pnpm --filter @tolk-og-laer/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.8.1",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.11"
  }
}
