# Public mobile/web values (safe for clients)
APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_REALTIME_URL=wss://realtime-production-bbae.up.railway.app/v1/realtime

# Server-only values — never expose with EXPO_PUBLIC_ or VITE_ prefixes
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REALTIME_SERVICE_SECRET=
OPENAI_API_KEY=
TRANSLATION_PROVIDER_API_KEY=
STT_PROVIDER_API_KEY=
TTS_PROVIDER_API_KEY=

# Realtime container runtime
PORT=8080
REALTIME_HEARTBEAT_INTERVAL_MS=20000
REALTIME_MAX_SESSION_SECONDS=3600
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_MAX_PAYLOAD_BYTES=524288

# Operational controls
REALTIME_USER_DAILY_BUDGET_NOK=
LOG_LEVEL=info
