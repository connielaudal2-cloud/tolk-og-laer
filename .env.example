SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REALTIME_SERVICE_SECRET=
OPENAI_API_KEY=
TRANSLATION_PROVIDER_API_KEY=
STT_PROVIDER_API_KEY=
TTS_PROVIDER_API_KEY=

# Operational controls
REALTIME_MAX_SESSION_SECONDS=3600
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_USER_DAILY_BUDGET_NOK=
LOG_LEVEL=info
