{
  "name": "@tolk-og-laer/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "build": "expo export --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src app.config.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tolk-og-laer/api-client": "workspace:*",
    "@tolk-og-laer/contracts": "workspace:*",
    "@tolk-og-laer/native-audio": "file:modules/tolk-native-audio",
    "expo": "57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-modules-core": "~57.0.14",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
