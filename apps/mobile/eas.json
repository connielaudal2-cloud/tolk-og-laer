{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote", "requireCommit": true },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": { "resourceClass": "m-medium" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": { "resourceClass": "m-medium" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": { "resourceClass": "m-medium" }
    }
  },
  "submit": { "production": {} }
}
